# Zalo Mini App tooling configuration. Keep the real values only in .env.
APP_ID=
ZMP_TOKEN=

# Frontend runtime configuration. Vite only exposes variables prefixed with VITE_.
VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_API_TIMEOUT_MS=15000

# Dev-only browser sign-in: must equal the backend AUTH_DEV_ZALO_TOKEN. Used only
# by `zmp start`/vite dev when the Zalo SDK has no real token (outside Zalo).
# VITE_DEV_ZALO_TOKEN=

# Show the media lab (Profile → Media lab) in a build; always on in dev.
# VITE_MEDIA_LAB=true
