# Zalo Mini App tooling configuration. Keep the real values only in .env.
APP_ID=
ZMP_TOKEN=

# Frontend runtime configuration. Vite only exposes variables prefixed with VITE_.
VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_API_TIMEOUT_MS=15000

# Dev-only browser sign-in: must equal the backend AUTH_DEV_ZALO_TOKEN. Used only
# by `zmp start`/vite dev when the Zalo SDK has no real token (outside Zalo).
# VITE_DEV_ZALO_TOKEN=

# Show the media lab (Profile → Media lab) in a build; always on in dev.
# VITE_MEDIA_LAB=true

# Home feed: play a card's short video preview near the middle of the screen. Off unless "true", until measured on devices.
VITE_FEED_AUTOPLAY=false

# Crash reporting (Sentry). Unset DSN = Sentry fully off and not in the bundle.
# VITE_SENTRY_DSN=https://<key>@o<org>.ingest.<region>.sentry.io/<project>
# Share of page loads/navigations traced, 0 to 1 (default 0.1).
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# Defaults to the Zalo shell's APP_ENV (development/testing), else production ("local" in vite dev).
# VITE_SENTRY_ENVIRONMENT=
# Send sentry-trace/baggage to VITE_API_BASE_URL. Only after the API's CORS allows those headers.
# VITE_SENTRY_TRACE_PROPAGATION=false
# Build only: upload source maps, then delete them from www/. Never commit the token.
# SENTRY_AUTH_TOKEN= SENTRY_ORG= SENTRY_PROJECT=
